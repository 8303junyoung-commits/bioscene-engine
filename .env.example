# Supabase project values. The publishable key is intentionally safe for browser use with RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Edge Function base URL used by the versioned room adapter.
VITE_BIOSCENE_API_BASE=https://your-project.supabase.co/functions/v1/bioscene-api

# QA-only server-side variables. Never prefix the API key with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
QA_GEMINI_ENABLED=false
QA_EXTERNAL_AI=false
QA_GEMINI_MAX_CALLS=3
QA_GEMINI_MAX_TOKENS=2048
QA_EXPLORATORY_MAX_STEPS=20
QA_EXPLORATORY_MAX_MINUTES=5
QA_UPDATE_BASELINES=false
